{
  "manifest_version": 3,
  "name": "AyTube Cookie Exporter",
  "version": "1.0.0",
  "description": "Export YouTube cookies in Netscape format in one click for AyTube and yt-dlp.",
  "permissions": [
    "cookies",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AyTube Cookie Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aytube-cookie-exporter@sinchu.org",
      "strict_min_version": "109.0"
    }
  }
}

include README.md
include LICENSE
include pyproject.toml
include setup.py
include CHANGELOG.md
recursive-include examples *.py
recursive-include tests *.py *.sh
recursive-include extension *

# Exclude user credentials, temporary files, and media artifacts
exclude *cookie*.txt
exclude *cookies*.txt
exclude *.cookie
exclude *.cookies
exclude cookies_file
exclude cookies
exclude *.mp4
exclude *.webm
exclude *.m4a
exclude *.mp3
exclude *.jpg
exclude *.jpeg
exclude *.png
exclude *.log
recursive-exclude aytube/__pycache__ *
recursive-exclude tests/__pycache__ *
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
